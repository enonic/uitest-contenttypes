<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<content-type xmlns="urn:enonic:xp:model:1.0">
  <display-name>content-sel-conf1</display-name>
  <super-type>base:structured</super-type>
  <form>

    <input name="allowArticle" type="ContentSelector">
      <label>Allow all content items</label>
      <occurrences minimum="2" maximum="8"/>
      <config>
        <allowContentType>article</allowContentType>  
        <allowPath>${site}/articles*/</allowPath>  

      </config>
    </input>

  </form>
</content-type>
